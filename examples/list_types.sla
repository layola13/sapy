@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

fn count_true(bs: &Vec<bool>) -> i64 {
    let c: i64 = 0;
    let i: i64 = 0;
    while (i < (len(bs) as i64)) {
        if bs[i] {
            c = (c + 1);
        };
        i = (i + 1);
    }
    return c;
}

fn main() -> i32 {
    let flags: Vec<bool> = Vec::new();
    flags.push(true);
    flags.push(false);
    flags.push(true);
    flags.push(true);
    flags.push(false);
    println("{}", count_true(&flags));
    println("{}", (len(flags) as i64));
    if flags[0] { println("True"); } else { println("False"); };
    return 0;
}
