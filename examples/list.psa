def total(values):
    t = 0
    i = 0
    while i < len(values):
        t += values[i]
        i += 1
    return t

def add_one(values):
    values.append(1)

xs = [1, 2, 3]
xs.append(4)
print(len(xs))
print(xs[0] + xs[3])
xs[1] = 20
xs[2] += 100
print(total(xs))
print(total(xs))
add_one(xs)
print(len(xs))
ys = xs
print(len(ys))
print(ys[2])
