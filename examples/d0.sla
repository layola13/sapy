@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/math.sai"

fn __psa_ipow(a: i64, e: i64) -> i64 {
    let r = 1;
    let b = a;
    let n = e;
    while n > 0 {
        if (n & 1) == 1 { r = r * b; };
        b = b * b;
        n = n >> 1;
    }
    return r;
}

fn main() -> i32 {
    println("{}", __psa_ipow(2, 10));
    if (sa_math_pow(2 as f64, -(1) as f64) == 0.5) { println("True"); } else { println("False"); };
    if (sa_math_pow(1.5, 2 as f64) == 2.25) { println("True"); } else { println("False"); };
    println("{}", (6 & 3));
    println("{}", (6 | 3));
    println("{}", (6 ^ 3));
    println("{}", (1 << 10));
    println("{}", (1024 >> 5));
    println("{}", (-(5) - 1));
    if ((1 < 2) && (2 < 3)) { println("True"); } else { println("False"); };
    if ((3 > 2) && (2 > 1)) { println("True"); } else { println("False"); };
    let x: i64 = 7;
    let __psa_ifexp_1: i64 = 0;
    if (x < 5) {
        __psa_ifexp_1 = (x + 1);
    } else {
        __psa_ifexp_1 = (x - 1);
    };
    println("{}", __psa_ifexp_1);
    let __psa_ifexp_3: i64 = 0;
    if (x > 5) {
        __psa_ifexp_3 = 1;
    } else {
        let __psa_ifexp_2: i64 = 0;
        if (x > 3) {
            __psa_ifexp_2 = 2;
        } else {
            __psa_ifexp_2 = 3;
        };
        __psa_ifexp_3 = __psa_ifexp_2;
    };
    let y: i64 = __psa_ifexp_3;
    println("{}", y);
    let n: i64 = 3;
    println("hello, n+1={}", (n + 1)) ;
    let ok: bool = true;
    if ok { println("ok=True") ; } else { println("ok=False") ; };
    let a: i64 = 5;
    let __psa_asn_4: i64 = __psa_ipow(a, 2);
    a = __psa_asn_4;
    println("{}", a);
    a = (a & 12);
    println("{}", a);
    return 0;
}
