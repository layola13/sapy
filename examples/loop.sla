@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"

fn __psa_floordiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    let r = a % b;
    if r != 0 && ((r < 0) != (b < 0)) { return q - 1; };
    return q;
}

fn __psa_floormod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 && ((r < 0) != (b < 0)) { return r + b; };
    return r;
}

fn main() -> i32 {
    let total: i64 = 0;
    {
        let __psa_stop_2: i64 = 101;
        let i: i64 = 1;
        while i < __psa_stop_2 {
            total = (total + i);
            i = i + 1;
        }
    }
    println("{}", total);
    let n: i64 = 0;
    while true {
        n = (n + 1);
        if (n == 5) {
            break;
        };
    }
    println("{}", n);
    println("{}", __psa_floordiv(-(7), 2));
    println("{}", __psa_floormod(-(7), 2));
    if (((7 as f64) / (2 as f64)) == 3.5) { println("True"); } else { println("False"); };
    if (1 < 2) { println("True"); } else { println("False"); };
    return 0;
}
