xs = [i * i for i in range(6)]
print(xs)
evens = [i for i in range(10) if i % 2 == 0]
print(evens)
words = ["a", "bb", "ccc"]
lens = [len(w) for w in words]
print(lens)
sq = {i: i * i for i in range(4)}
print(sq)
st = {i % 3 for i in range(10)}
print(st)
pairs = [(i, j) for i in range(3) for j in range(2)]
print(pairs)
src = [1, 2, 3, 4]
dbl = [v * 2 for v in src]
print(dbl)
big = [v for v in src if v > 2]
print(big)
