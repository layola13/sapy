@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/vec.sa"

fn total(values: &Vec<i64>) -> i64 {
    let t: i64 = 0;
    let i: i64 = 0;
    while (i < (len(values) as i64)) {
        t = (t + values[i]);
        i = (i + 1);
    }
    return t;
}

fn add_one(values: &Vec<i64>) -> i32 {
    values.push(1);
    return 0;
}

fn main() -> i32 {
    let xs: Vec<i64> = Vec::new();
    xs.push(1);
    xs.push(2);
    xs.push(3);
    xs.push(4);
    println("{}", (len(xs) as i64));
    println("{}", (xs[0] + xs[3]));
    xs[1] = 20;
    xs[2] = (xs[2] + 100);
    println("{}", total(&xs));
    println("{}", total(&xs));
    add_one(&xs);
    println("{}", (len(xs) as i64));
    let ys: Vec<i64> = xs;
    println("{}", (len(ys) as i64));
    println("{}", ys[2]);
    return 0;
}
