xs = list([3, 1, 2])
xs.append(4)
print(xs)
xs.extend([5, 6])
print(xs)
xs.insert(0, 9)
print(xs)
print(xs.pop())
print(xs.pop(0))
print(xs)
xs.remove(3)
print(xs)
print(xs.index(2))
print(xs.count(1))
xs.reverse()
print(xs)
xs.sort()
print(xs)
ys = xs.copy()
ys.append(99)
print(ys)
print(xs)
xs.clear()
print(xs)
print(len(xs))
d = {"a": 1, "b": 2}
print(d.get("a"))
print(d.get("z"))
print(d.get("z", 7))
print(list(d.keys()))
print(list(d.values()))
print(list(d.items()))
print(d.setdefault("c", 3))
print(d)
print(d.pop("b"))
print(d)
d.update({"d": 4})
print(d)
e = d.copy()
e["e"] = 5
print(e)
print(d)
d.clear()
print(d)
