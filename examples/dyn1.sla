fn __psa_ipow(a: i64, e: i64) -> i64 {
    let r = 1;
    let b = a;
    let n = e;
    while n > 0 {
        if (n & 1) == 1 { r = r * b; };
        b = b * b;
        n = n >> 1;
    }
    return r;
}

fn __psa_floordiv(a: i64, b: i64) -> i64 {
    let q = a / b;
    let r = a % b;
    if r != 0 && ((r < 0) != (b < 0)) { return q - 1; };
    return q;
}

fn __psa_floormod(a: i64, b: i64) -> i64 {
    let r = a % b;
    if r != 0 && ((r < 0) != (b < 0)) { return r + b; };
    return r;
}

