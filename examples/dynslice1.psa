xs = [0, 1, 2, 3, 4, 5]
print(xs[1:3])
print(xs[:2])
print(xs[3:])
print(xs[:])
print(xs[-2:])
print(xs[:-1])
print(xs[::2])
print(xs[::-1])
print(xs[4:1:-1])
print(xs[10:20])
print(xs[-100:100])
print(xs[3:1])
print(xs[1:5:2])
print(xs[5:0:-2])
a = xs[2:4]
print(a)
print(len(a))
s = "hello world"
print(s[0:5])
print(s[6:])
print(s[::-1])
print(s[::2])
print(s[-5:])
print("abcdef"[1:4])
print("abcdef"[::-2])
d = [10, "x", 30, None]
print(d[1:3])
print(d[::-1])
e = []
print(e[1:2])
print(e[::-1])
def mid(v):
    return v[1:-1]
tmp = [7, "x", 9]
print(mid(tmp))
print(mid("abcd"))
i = 2
print(xs[i - 1:i + 2])
print(xs[1 + 1:6 - 1])
