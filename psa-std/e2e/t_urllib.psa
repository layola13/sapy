import urllib

print(urllib.quote("a b/c?d"))
print(urllib.quote_plus("a b+c"))
print(urllib.unquote("a%20b%2Bc"))
print(urllib.unquote_plus("a+b%2Bc"))
print(urllib.urlencode({"name": "a b", "n": "3"}))
print(urllib.urljoin("http://ex.com/a/b/c", "../d"))
print(urllib.urljoin("http://ex.com/a/b/c", "/x"))
print(urllib.parse_qs("a=1&b=&c&a=2"))
req = urllib.Request("http://127.0.0.1:18713/hello")
resp = urllib.urlopen("http://127.0.0.1:18713/hello")
print("done")
