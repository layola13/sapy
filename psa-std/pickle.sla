            __psa_list_push(t, item);
            handled = true;
        };
        if op == 101 { __psa_pkl_appends(st); handled = true; };
        if op == 115 {
            let val = __psa_pkl_pop(st);
            let key = __psa_pkl_pop(st);
            let d = __psa_pkl_top(st);
            if d.tag != 5 { panic(77314); };
            __psa_pkl_check_key(key);
            __psa_dict_set(d, key, val);
            handled = true;
        };
        if op == 117 { __psa_pkl_setitems(st); handled = true; };
        if op == 48 {
            let dropped = __psa_pkl_pop(st);
            handled = true;
        };
        if op == 49 {
            let mp = __psa_pkl_mark_pos(st);
            if mp < 0 { panic(77314); };
            let stack = __psa_pkl_st_stack(st);
            __psa_vec_truncate_h(stack.ipay as ptr, mp);
            handled = true;
        };
        if op == 50 { __psa_pkl_push(st, __psa_pkl_top(st)); handled = true; };
        if op == 112 {
            let idx = __psa_pkl_parse_index(__psa_pkl_line(st));
            __psa_pkl_memo_set(st, idx, __psa_pkl_top(st));
            handled = true;
        };
        if op == 113 {
            let idx = __psa_pkl_getb(st);
            __psa_pkl_memo_set(st, idx, __psa_pkl_top(st));
            handled = true;
        };
        if op == 114 {
            let idx = __psa_pkl_u32le(st);
            __psa_pkl_memo_set(st, idx, __psa_pkl_top(st));
            handled = true;
        };
        if op == 148 {
            let memo = __psa_pkl_st_memo(st);
            let idx = __psa_vec_len_h(memo.ipay as ptr);
            __psa_pkl_memo_set(st, idx, __psa_pkl_top(st));
            handled = true;
        };
        if op == 103 {
            let idx = __psa_pkl_parse_index(__psa_pkl_line(st));
            __psa_pkl_push(st, __psa_pkl_memo_get(st, idx));
            handled = true;
        };
        if op == 104 {
            let idx = __psa_pkl_getb(st);
            __psa_pkl_push(st, __psa_pkl_memo_get(st, idx));
            handled = true;
        };
        if op == 106 {
            let idx = __psa_pkl_u32le(st);
            __psa_pkl_push(st, __psa_pkl_memo_get(st, idx));
            handled = true;
        };
        if op == 133 { __psa_pkl_tuple_n(st, 1); handled = true; };
        if op == 134 { __psa_pkl_tuple_n(st, 2); handled = true; };
        if op == 135 { __psa_pkl_tuple_n(st, 3); handled = true; };
        // The security boundary: GLOBAL (99),
        // STACK_GLOBAL (147), REDUCE (82), BUILD
        // (98), OBJ (111), INST (105), NEWOBJ (129),
        // NEWOBJ_EX (146), EXT1 (130), EXT2 (131),
        // EXT4 (132), PERSID (80), BINPERSID (81).
        if op == 99 || op == 147 || op == 82 || op == 98 || op == 111 || op == 105 || op == 129 || op == 146 || op == 130 || op == 131 || op == 132 || op == 80 || op == 81 { panic(77312); };
        // Recognized but outside the data subset:
        // EMPTY_SET (143), ADDITEMS (144), FROZENSET
        // (145), BYTEARRAY8 (150), NEXT_BUFFER (151),
        // READONLY_BUFFER (152).
        if op == 143 || op == 144 || op == 145 || op == 150 || op == 151 || op == 152 { panic(77316); };
        if !(handled) { panic(77314); };
    }
    return result;
}

fn psa_pickle_loads(data: PsaVal) -> PsaVal {
    // The input is a byte buffer: a tag-15 bytes
    // value, or a tag-6 str holding raw bytes (the
    // file surface's return shape).
    if data.tag != 6 {
        if data.tag != 15 { panic(77310); };
    };
    let st = __psa_list_new();
    __psa_vec_push_h(st.ipay as ptr, data);
    __psa_vec_push_h(st.ipay as ptr, __psa_box_int(0));
    __psa_vec_push_h(st.ipay as ptr, __psa_list_new());
    __psa_vec_push_h(st.ipay as ptr, __psa_list_new());
    return __psa_pkl_run(st);
}

fn psa_pickle_load(f: PsaVal) -> PsaVal {
    // CPython's load(file): read the whole file
    // through the runtime file surface, then parse.
    if f.tag != 12 { panic(77310); };
    return psa_pickle_loads(__psa_file_read_all(f));
}
