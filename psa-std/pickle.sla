        };
        if op == 76 {
            // LONG: decimal text with a trailing L.
            let line = __psa_pkl_line(st);
            let ln = __psa_bytes_len_h(line.ipay as ptr);
            if ln > 0 {
                if (__psa_bytes_get_h(line.ipay as ptr, ln - 1) as i64) == 76 {
                    line = __psa_str_sub_bytes(line, 0, ln - 1);
                };
            };
            __psa_pkl_push(st, __psa_box_int(__psa_pkl_parse_i64(line)));
            handled = true;
        };
        if op == 74 { __psa_pkl_push(st, __psa_box_int(__psa_pkl_i32le(st))); handled = true; };
        if op == 75 { __psa_pkl_push(st, __psa_box_int(__psa_pkl_getb(st))); handled = true; };
        if op == 77 {
            let b0 = __psa_pkl_getb(st);
            let b1 = __psa_pkl_getb(st);
            __psa_pkl_push(st, __psa_box_int(b0 | (b1 << 8)));
            handled = true;
        };
        if op == 138 {
            let n = __psa_pkl_getb(st);
            __psa_pkl_push(st, __psa_box_int(__psa_pkl_decode_long(st, n)));
            handled = true;
        };
        if op == 139 {
            let n = __psa_pkl_u32le(st);
            __psa_pkl_push(st, __psa_box_int(__psa_pkl_decode_long(st, n)));
            handled = true;
        };
        if op == 70 {
            // FLOAT: decimal text.
            let line = __psa_pkl_line(st);
            __psa_pkl_push(st, __psa_box_float(__psa_str_to_float(line)));
            handled = true;
        };
        if op == 71 {
            // BINFLOAT: 8 big-endian bit bytes.
            let bits: i64 = 0;
            let k: i64 = 0;
            while k < 8 {
                bits = (bits << 8) | __psa_pkl_getb(st);
                k = k + 1;
            }
            __psa_pkl_push(st, __psa_box_float(__psa_pkl_bits_f64(bits)));
            handled = true;
        };
        if op == 83 {
            let line = __psa_pkl_line(st);
            __psa_pkl_push(st, __psa_pkl_decode_string(line));
            handled = true;
        };
        if op == 86 {
            let line = __psa_pkl_line(st);
            __psa_pkl_push(st, __psa_pkl_decode_unicode(line));
            handled = true;
        };
        if op == 84 {
            let n = __psa_pkl_i32le(st);
            __psa_pkl_push(st, __psa_pkl_readn(st, n, false));
            handled = true;
        };
        if op == 85 {
            let n = __psa_pkl_getb(st);
            __psa_pkl_push(st, __psa_pkl_readn(st, n, false));
            handled = true;
        };
        if op == 88 {
            let n = __psa_pkl_u32le(st);
            let buf = __psa_pkl_readn(st, n, false);
            __psa_pkl_utf8_check(buf);
            __psa_pkl_push(st, buf);
            handled = true;
        };
        if op == 140 {
            let n = __psa_pkl_getb(st);
            let buf = __psa_pkl_readn(st, n, false);
            __psa_pkl_utf8_check(buf);
            __psa_pkl_push(st, buf);
            handled = true;
        };
        if op == 141 {
            let n = __psa_pkl_len64(st);
            let buf = __psa_pkl_readn(st, n, false);
            __psa_pkl_utf8_check(buf);
            __psa_pkl_push(st, buf);
            handled = true;
        };
        if op == 67 {
            let n = __psa_pkl_getb(st);
            __psa_pkl_push(st, __psa_pkl_readn(st, n, true));
            handled = true;
        };
        if op == 66 {
            let n = __psa_pkl_u32le(st);
            __psa_pkl_push(st, __psa_pkl_readn(st, n, true));
            handled = true;
        };
        if op == 142 {
            let n = __psa_pkl_len64(st);
            __psa_pkl_push(st, __psa_pkl_readn(st, n, true));
            handled = true;
        };
        if op == 93 { __psa_pkl_push(st, __psa_list_new()); handled = true; };
        if op == 41 { __psa_pkl_push(st, __psa_tuple_new()); handled = true; };
        if op == 125 { __psa_pkl_push(st, __psa_dict_new()); handled = true; };
        if op == 40 { __psa_pkl_push(st, __psa_pkl_mark_val()); handled = true; };
        if op == 108 { __psa_pkl_build_list(st); handled = true; };
        if op == 116 { __psa_pkl_build_tuple(st); handled = true; };
        if op == 100 { __psa_pkl_build_dict(st); handled = true; };
        if op == 97 {
            let item = __psa_pkl_pop(st);
