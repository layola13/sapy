}

fn __psa_argparse_apply_flag(collected: PsaVal, seen: PsaVal, ai: i64, a: PsaVal) -> void {
    // One occurrence of a flag action.
    let act = __psa_dict_get(a, __psa_argparse_lit_action());
    let coll = __psa_list_get(collected, ai);
    if __psa_str_eq(act, __psa_argparse_lit_store_true()) { __psa_list_push(coll, __psa_box_bool(true)); };
    if __psa_str_eq(act, __psa_argparse_lit_store_false()) { __psa_list_push(coll, __psa_box_bool(false)); };
    if __psa_str_eq(act, __psa_argparse_lit_count()) { __psa_list_push(coll, __psa_box_int(1)); };
    __psa_vec_set_h(seen.ipay as ptr, ai, __psa_box_bool(true));
    return;
}

fn __psa_argparse_default_value(parser: PsaVal, a: PsaVal) -> PsaVal {
    // The namespace value of an action that never
    // appeared: its default, with CPython's parse-
    // time treatment -- a str default is converted
    // through type, and a non-None default is
    // checked against choices.
    let d = __psa_dict_get(a, __psa_argparse_lit_default());
    let type_name = __psa_dict_get(a, __psa_argparse_lit_type());
    if d.tag == 6 {
        if !(__psa_str_eq(type_name, __psa_argparse_lit_str_name())) {
            return __psa_argparse_convert(parser, a, d);
        };
    };
    if d.tag != 3 {
        let choices = __psa_dict_get(a, __psa_argparse_lit_choices());
        if choices.tag == 4 {
            __psa_argparse_check_choices(parser, a, d, __psa_repr_of(d));
        };
    };
    return d;
}

