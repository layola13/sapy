        i = i + 1;
    }
    return false;
}

fn __psa_argparse_tok_is_option(tok: PsaVal, has_neg: bool) -> bool {
    let n = __psa_str_bytes_len(tok);
    if n < 2 { return false; };
    if __psa_argparse_byte(tok, 0) != 45 { return false; };
    if __psa_str_eq(tok, __psa_argparse_lit_dashdash()) { return false; };
    if __psa_argparse_is_negnum(tok) {
        if !has_neg { return false; };
    };
    return true;
}

fn __psa_argparse_consumable(tok: PsaVal, has_neg: bool) -> bool {
    if __psa_str_eq(tok, __psa_argparse_lit_dashdash()) { return false; };
    if __psa_argparse_tok_is_option(tok, has_neg) { return false; };
    return true;
}

fn __psa_argparse_consume(parser: PsaVal, a: PsaVal, attached: PsaVal, tokens: PsaVal, i: i64, has_neg: bool) -> (PsaVal, i64) {
