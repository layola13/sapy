    // valued action takes: the attached value (or
    // None) plus following consumable tokens per
    // nargs. Shortage is a parse error with
    // CPython's text.
    let raws = __psa_list_new();
    let ng = __psa_argparse_nargs(a);
    let ntok = __psa_list_len(tokens);
    if attached.tag == 6 { __psa_list_push(raws, attached); };
    if ng == -1 {
        if attached.tag == 6 { return (raws, i); };
        if i < ntok {
            if __psa_argparse_consumable(__psa_list_get(tokens, i), has_neg) {
                __psa_list_push(raws, __psa_list_get(tokens, i));
                return (raws, i + 1);
            };
        };
        let msg = __psa_argparse_lit_argument();
        msg = __psa_str_append_str(msg, __psa_argparse_disp(a));
        msg = __psa_str_append_str(msg, __psa_argparse_lit_expected_one());
        __psa_argparse_error(parser, msg);
        return (raws, i);
    };
    if ng == -2 {
        if attached.tag == 6 { return (raws, i); };
        if i < ntok {
            if __psa_argparse_consumable(__psa_list_get(tokens, i), has_neg) {
                __psa_list_push(raws, __psa_list_get(tokens, i));
                return (raws, i + 1);
            };
        };
        return (raws, i);
    };
    if ng == -3 {
        while i < ntok {
            if !(__psa_argparse_consumable(__psa_list_get(tokens, i), has_neg)) { break; };
            __psa_list_push(raws, __psa_list_get(tokens, i));
            i = i + 1;
        }
        return (raws, i);
    };
    if ng == -4 {
        while i < ntok {
            if !(__psa_argparse_consumable(__psa_list_get(tokens, i), has_neg)) { break; };
            __psa_list_push(raws, __psa_list_get(tokens, i));
            i = i + 1;
        }
        if __psa_list_len(raws) == 0 {
            let msg = __psa_argparse_lit_argument();
            msg = __psa_str_append_str(msg, __psa_argparse_disp(a));
            msg = __psa_str_append_str(msg, __psa_argparse_lit_expected_at_least());
            __psa_argparse_error(parser, msg);
        };
        return (raws, i);
    };
