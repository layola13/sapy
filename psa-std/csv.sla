    let s = __psa_str_new();
    s = __psa_str_push(s, 113u8); s = __psa_str_push(s, 117u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 110u8); s = __psa_str_push(s, 103u8);
