    let s = __psa_str_new();
    s = __psa_str_push(s, 100u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 117u8); s = __psa_str_push(s, 98u8); s = __psa_str_push(s, 108u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 113u8); s = __psa_str_push(s, 117u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 101u8);
