fn __psa_csv_lit_strict() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 99u8); s = __psa_str_push(s, 116u8);
