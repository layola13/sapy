    let s = __psa_str_new();
    s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 107u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 112u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 110u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 108u8); s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 112u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 99u8); s = __psa_str_push(s, 101u8);
