    s = __psa_str_push(s, 108u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 110u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 109u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 110u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 114u8);
