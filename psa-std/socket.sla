    let ri: u64 = 0;
    while ri < outn[0] {
        data = __psa_str_push(data, buf[ri]);
        ri = ri + 1;
    }
    let at = __psa_sock_addr_tuple(outa[0]);
    let fr = sa_net_addr_free(outa[0]);
    let t = __psa_tuple_new();
    __psa_tuple_push(t, data);
    __psa_tuple_push(t, at);
    return t;
}

// ---- lifecycle / options ----

fn psa_socket_close(sock: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    if __psa_sock_is_closed(rec) { return __psa_m_none(); };
    __psa_dict_set(rec, __psa_sock_lit_closed(), __psa_box_int(1));
    let h = __psa_sock_handle(rec);
    if h != 0 {
        let kind = __psa_sock_get_i(rec, __psa_sock_lit_kind());
        let role = __psa_sock_get_i(rec, __psa_sock_lit_role());
        if kind == 2 {
            let _ = sa_net_udp_close(h);
        };
        if kind == 1 {
            if role == 1 {
                let _ = sa_net_tcp_listener_close(h);
            } else {
                let _ = sa_net_tcp_stream_close(h);
            }
        };
        __psa_dict_set(rec, __psa_sock_lit_handle(), __psa_box_int(0));
    };
    return __psa_m_none();
}

// how: 0 = read half, 1 = write half, 2 = both
// (CPython SHUT_RD / SHUT_WR / SHUT_RDWR).
fn psa_socket_shutdown(sock: PsaVal, how: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    __psa_sock_check_open(rec);
    if how.tag != 0 { panic(77180); };
    if how.ipay < 0 { panic(77180); };
    if how.ipay > 2 { panic(77180); };
    let kind = __psa_sock_get_i(rec, __psa_sock_lit_kind());
    if kind != 1 { panic(77182); };
    let h = __psa_sock_handle(rec);
    if h == 0 { panic(77182); };
    let rc = sa_net_tcp_stream_shutdown(h, how.ipay as i32);
    return __psa_m_none();
}

fn psa_socket_settimeout(sock: PsaVal, val: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    if val.tag == 3 {
        __psa_dict_set(rec, __psa_sock_lit_timeout(), __psa_m_none());
    } else {
        if val.tag == 0 {
            if val.ipay < 0 { panic(77180); };
            __psa_dict_set(rec, __psa_sock_lit_timeout(), __psa_box_float(val.ipay as f64));
        } else {
            if val.tag != 1 { panic(77180); };
            if val.fpay < 0.0 { panic(77180); };
            __psa_dict_set(rec, __psa_sock_lit_timeout(), val);
        }
    };
    let h = __psa_sock_handle(rec);
    if h != 0 { __psa_sock_apply_timeout(rec, h); };
    return __psa_m_none();
}

fn psa_socket_gettimeout(sock: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    return __psa_dict_get(rec, __psa_sock_lit_timeout());
}

fn psa_socket_setblocking(sock: PsaVal, flag: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    let truthy = __psa_dyn_truthy(flag);
    if truthy {
        return psa_socket_settimeout(rec, __psa_m_none());
    };
    return psa_socket_settimeout(rec, __psa_box_float(0.0));
}

fn psa_socket_getpeername(sock: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    __psa_sock_check_open(rec);
    let kind = __psa_sock_get_i(rec, __psa_sock_lit_kind());
    let role = __psa_sock_get_i(rec, __psa_sock_lit_role());
    let h = __psa_sock_handle(rec);
    if h == 0 { panic(77182); };
    let outa = [0u64; 1];
    if kind == 2 {
        let st = sa_std_net_udp_peer_addr(h, &outa[0]);
        if st != 0 { __psa_sock_raise(st); };
    } else {
        if role == 1 { panic(77182); };
        let st = sa_std_net_tcp_stream_peer_addr(h, &outa[0]);
        if st != 0 { __psa_sock_raise(st); };
    };
    let t = __psa_sock_addr_tuple(outa[0]);
    let fr = sa_net_addr_free(outa[0]);
    return t;
}

fn psa_socket_getsockname(sock: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    __psa_sock_check_open(rec);
    let kind = __psa_sock_get_i(rec, __psa_sock_lit_kind());
    let role = __psa_sock_get_i(rec, __psa_sock_lit_role());
    let h = __psa_sock_handle(rec);
    if h == 0 {
