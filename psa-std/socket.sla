}

// Returns a 2-tuple (data, (host, port)). Datagram
// sockets only; on a stream socket CPython returns
// the peer address too, a form the psa record does
// not carry -- loud refusal (77185, registered).
fn psa_socket_recvfrom(sock: PsaVal, bufsize: PsaVal) -> PsaVal {
    let rec = __psa_sock_rec(sock);
    __psa_sock_check_open(rec);
    let kind = __psa_sock_get_i(rec, __psa_sock_lit_kind());
    if kind != 2 { panic(77185); };
    if bufsize.tag != 0 { panic(77180); };
    if bufsize.ipay < 0 { panic(77180); };
