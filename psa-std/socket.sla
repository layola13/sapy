    let st = sa_std_net_to_socket_addr_list(PTR_BYTE_ADD(&buf, 0), n, 0, &outl[0]);
    if st != 0 { __psa_sock_raise(st); };
    let list = outl[0];
    let found: u64 = 0;
    let done: bool = false;
    while done == false {
        let outok = [0u64; 1];
        let outa = [0u64; 1];
        let stn = sa_std_net_addr_list_next(list, &outok[0], &outa[0]);
        if stn != 0 { let fl = sa_std_net_addr_list_free(list); __psa_sock_raise(stn); };
        if outok[0] == 0 { done = true; } else {
            let ah = outa[0];
            if sa_net_addr_family(ah) == 2 {
                found = ah;
                done = true;
            } else {
                let fa = sa_net_addr_free(ah);
            }
        }
    }
    let fl2 = sa_std_net_addr_list_free(list);
    if found == 0 { panic(77181); };
    let hp = sa_net_addr_host(found);
    let hl = sa_net_addr_host_len(found);
    let out = __psa_str_new();
    let i: u64 = 0;
    while i < hl {
        out = __psa_str_push(out, PTR_BYTE_AT(hp, i));
        i = i + 1;
    }
    let fr = sa_net_addr_free(found);
    return out;
}

// ---- inet_* (pure byte logic, IPv4) ----

// Full CPython inet_aton grammar: 1-4 dot-separated
// parts, each decimal / octal (leading 0) / hex
// (leading 0x); the last part spans the remaining
// bytes. Returns the 4 packed bytes as a dyn str;
// malformed input panics 77182 (CPython raises
// OSError for inet_aton).
fn psa_socket_inet_aton(text: PsaVal) -> PsaVal {
    if text.tag != 6 { panic(77180); };
    let n = __psa_str_bytes_len(text);
    if n == 0 { panic(77182); };
    let parts = [0u64; 4];
    let nparts: i64 = 0;
    let cur: u64 = 0;
    let have: bool = false;
    let base: u64 = 10;
    let skipx: bool = false;
    let i: i64 = 0;
    while i <= n {
        let b: u8 = 46;
        if i < n { b = __psa_bytes_get_h(text.ipay as ptr, i); };
        if b == 46 {
            if have == false { panic(77182); };
            if nparts >= 4 { panic(77182); };
            let __ixp = nparts as u64;
            parts[__ixp] = cur;
            nparts = nparts + 1;
            cur = 0; have = false; base = 10; skipx = false;
        } else {
            if have == false {
                if b == 48 {
                    // peek: '0x' -> hex, else octal
                    let b2: u8 = 0;
                    if i + 1 < n { b2 = __psa_bytes_get_h(text.ipay as ptr, i + 1); };
                    if b2 == 120 { base = 16; skipx = true; };
                    if b2 == 88 { base = 16; skipx = true; };
                    if base != 16 { base = 8; };
                }
            };
            have = true;
            let d: i64 = -1;
            if b >= 48 {
                if b <= 57 { d = b as i64 - 48; };
            };
            if b >= 97 {
                if b <= 102 { d = b as i64 - 87; };
            };
            if b >= 65 {
                if b <= 70 { d = b as i64 - 55; };
            };
            if b == 120 { d = -2; };
            if b == 88 { d = -2; };
            if d == -1 { panic(77182); };
            if d == -2 {
                if skipx == false { panic(77182); };
                skipx = false;
            };
            if d >= 0 {
                if d as u64 >= base {
                    if base != 16 { panic(77182); };
                    if d as u64 >= 16 { panic(77182); };
                };
                cur = cur * base + d as u64;
                if cur > 4294967295 { panic(77182); };
            }
        };
        i = i + 1;
    }
    // Width checks per CPython: all parts but the
    // last are single bytes; the last spans the rest.
    let k: i64 = 0;
    while k < nparts - 1 {
        let __ixk = k as u64;
        if parts[__ixk] > 255 { panic(77182); };
        k = k + 1;
    }
    // Remaining bytes spanned by the last part.
    let rem: u64 = (5 - nparts) as u64;
    let lmax: u64 = 1;
    let j: u64 = 0;
    while j < rem {
        lmax = lmax * 256;
        j = j + 1;
    }
    let __ixb = (nparts - 1) as u64;
    if parts[__ixb] >= lmax { panic(77182); };
    let out = __psa_str_new();
    let q: i64 = 0;
    while q < nparts - 1 {
        let __ixq = q as u64;
        out = __psa_str_push(out, parts[__ixq] as u8);
        q = q + 1;
    }
    let __ixc = (nparts - 1) as u64;
    let last = parts[__ixc];
    let sh: u64 = rem - 1;
    let done: bool = false;
    while done == false {
        let byte = (last >> (sh * 8)) as u8;
        out = __psa_str_push(out, byte);
        if sh == 0 { done = true; } else { sh = sh - 1; };
    }
    return out;
}

fn psa_socket_inet_ntoa(packed: PsaVal) -> PsaVal {
    if packed.tag != 6 { panic(77180); };
    if __psa_str_bytes_len(packed) != 4 { panic(77182); };
    let out = __psa_str_new();
    let i: i64 = 0;
    while i < 4 {
        let b = __psa_bytes_get_h(packed.ipay as ptr, i);
        out = __psa_str_append_str(out, __psa_str_from_i64(b as i64));
        if i < 3 { out = __psa_str_push(out, 46u8); };
        i = i + 1;
    }
    return out;
}

// inet_pton(AF_INET, s): strict dotted quad only
// (CPython's pton rejects the short forms aton
// accepts). AF_INET6 panics 77185 (registered:
// the base's v6 parse/format externs do not expose
// a verified packed-byte form).
fn psa_socket_inet_pton(family: PsaVal, text: PsaVal) -> PsaVal {
    if family.tag != 0 { panic(77180); };
    if family.ipay == 10 { panic(77185); };
    if family.ipay != 2 { panic(77180); };
    if text.tag != 6 { panic(77180); };
    let n = __psa_str_bytes_len(text);
    let out = __psa_str_new();
    let cur: i64 = -1;
    let nparts: i64 = 0;
    let i: i64 = 0;
    while i <= n {
        let b: u8 = 46;
        if i < n { b = __psa_bytes_get_h(text.ipay as ptr, i); };
        if b == 46 {
            if cur < 0 { panic(77182); };
            if nparts >= 4 { panic(77182); };
            out = __psa_str_push(out, cur as u8);
            nparts = nparts + 1;
            cur = -1;
        } else {
            if b < 48 { panic(77182); };
            if b > 57 { panic(77182); };
            if cur < 0 { cur = 0; };
            cur = cur * 10 + (b as i64 - 48);
            if cur > 255 { panic(77182); };
        };
        i = i + 1;
    }
    if nparts != 4 { panic(77182); };
    return out;
}

fn psa_socket_inet_ntop(family: PsaVal, packed: PsaVal) -> PsaVal {
    if family.tag != 0 { panic(77180); };
    if family.ipay == 10 { panic(77185); };
    if family.ipay != 2 { panic(77180); };
    return psa_socket_inet_ntoa(packed);
}

