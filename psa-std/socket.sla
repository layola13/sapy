        let st2 = sa_std_net_udp_local_addr(hh, &outa2[0]);
        if st2 != 0 { __psa_sock_raise(st2); };
        let t2 = __psa_sock_addr_tuple(outa2[0]);
        let fr2 = sa_net_addr_free(outa2[0]);
        return t2;
