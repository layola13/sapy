    return out;
}

fn psa_socket_gethostbyname(name: PsaVal) -> PsaVal {
    if name.tag != 6 { panic(77180); };
    let buf = [0u8; 256];
    let sni = __psa_str_bytes_len(name);
    if sni > 256 { panic(77180); };
