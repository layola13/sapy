    let outa = [0u64; 1];
    if kind == 2 {
        let st = sa_std_net_udp_local_addr(h, &outa[0]);
        if st != 0 { __psa_sock_raise(st); };
    } else {
        if role == 1 {
            let st = sa_std_net_tcp_listener_local_addr(h, &outa[0]);
            if st != 0 { __psa_sock_raise(st); };
        } else {
            let st = sa_std_net_tcp_stream_local_addr(h, &outa[0]);
            if st != 0 { __psa_sock_raise(st); };
        }
    };
    let t = __psa_sock_addr_tuple(outa[0]);
    let fr = sa_net_addr_free(outa[0]);
    return t;
}

// ---- name services ----

fn psa_socket_gethostname() -> PsaVal {
    let buf = [0u8; 256];
    let outl = [0u64; 1];
    let st = sa_std_net_hostname(PTR_BYTE_ADD(&buf, 0), 256, &outl[0]);
    if st != 0 { __psa_sock_raise(st); };
    let out = __psa_str_new();
    let i: u64 = 0;
