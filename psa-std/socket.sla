        // only honest answer a stream record has.
        if kind == 1 {
            let t = __psa_tuple_new();
            __psa_tuple_push(t, __psa_dict_get(rec, __psa_sock_lit_bhost()));
            __psa_tuple_push(t, __psa_box_int(__psa_sock_get_i(rec, __psa_sock_lit_bport())));
            return t;
