    if cap > 4096 { cap = 4096; };
    let h = __psa_sock_ensure_udp(rec);
    let buf = [0u8; 4096];
    let outn = [0u64; 1];
    let outa = [0u64; 1];
    let st = sa_std_net_udp_recv_from(h, PTR_BYTE_ADD(&buf, 0), cap as u64, &outn[0], &outa[0]);
    if st != 0 { __psa_sock_raise(st); };
