fn __psa_urlb_free_handles(client: i64, req: i64, resp: i64) -> void {
    if resp != 0 { sa_http_client_resp_free(resp as ptr); };
    if req != 0 { sa_http_client_req_free(req as ptr); };
    if client != 0 { sa_http_client_free(client as ptr); };
}

// The urlopen engine: follows redirects like
// CPython's HTTPRedirectHandler (at most 10 hops;
// 301/302 turn POST into GET, 303 turns every
// method but HEAD into GET and drops the body,
// 307/308 keep method and body), raises HTTPError
// (77187) on a final error status, URLError
// (77186) on transport failure and on non-http(s)
// schemes. The response body is copied out of the
// base response; the base handles stay in the
// record for getheader until close().
// Stages one header pair into scratch buffers and
// adds it to the request; -1 when a side exceeds the
// 1024-byte staging cap, else the extern status.
// (Staging lives in its own function: borrowing the
// buffers inside the header loop trips the SA
// referee's loop-head state check.)
fn __psa_urlb_add_header(reqh: i64, k: PsaVal, v: PsaVal) -> i32 {
    let kb = [0u8; 1024];
    let kn = __psa_urlb_len(k);
    if kn > 1024 { return -1; };
    let ki: i64 = 0;
    while ki < kn {
        let __ix = ki as u64;
        kb[__ix] = __psa_urlb_byte(k, ki);
        ki = ki + 1;
    }
    let vb = [0u8; 1024];
    let vn = __psa_urlb_len(v);
    if vn > 1024 { return -1; };
    let vi: i64 = 0;
    while vi < vn {
        let __ix = vi as u64;
        vb[__ix] = __psa_urlb_byte(v, vi);
        vi = vi + 1;
    }
    let sth = sa_http_client_req_add_header_v2(reqh as ptr, PTR_BYTE_ADD(&kb, 0), kn as u64, PTR_BYTE_ADD(&vb, 0), vn as u64);
    return sth;
}

fn __psa_urlb_open(req0: PsaVal, timeout: PsaVal) -> PsaVal {
