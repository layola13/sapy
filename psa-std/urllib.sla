            if v.tag != 6 { __psa_urlb_free_handles(client, reqh, 0); panic(77188); };
            if __psa_str_eq(__psa_urlb_lower(k), __psa_urlb_lower(__psa_urlb_lit_content_type())) { has_ct = true; };
