        if n.ipay < take { take = n.ipay; };
    };
    let out = __psa_urlb_range(body, pos.ipay, pos.ipay + take);
    __psa_dict_set(rec, __psa_urlb_lit_pos(), __psa_box_int(pos.ipay + take));
    return out;
}

fn psa_urllib_readline(resp: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    let pos = __psa_dict_get(rec, __psa_urlb_lit_pos());
    if pos.ipay < 0 { panic(77188); };
    let body = __psa_dict_get(rec, __psa_urlb_lit_body());
    let total = __psa_urlb_len(body);
    let end = total;
    let i = pos.ipay;
    let scanning: bool = true;
    while scanning {
        if i >= total { scanning = false; } else {
            if __psa_urlb_byte(body, i) == 10 { end = i + 1; scanning = false; } else { i = i + 1; };
