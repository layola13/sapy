        let outr = [0u64; 1];
        let str = sa_http_client_req_new_v2(client as ptr, mcode, PTR_BYTE_ADD(&ubuf, 0), un as u64, &outr[0]);
        if str != 0 { __psa_urlb_free_handles(client, 0, 0); panic(77186); };
