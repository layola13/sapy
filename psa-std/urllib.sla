@import "sa_std/http_client.sai"

// psa_std urllib (net group L2): CPython's
// urllib.request and urllib.parse, flattened into
// one module of module-level functions (the psa
// import surface is one name per module; the
// WIRING spec maps both `import urllib.request`
// and `import urllib.parse` onto this file).
// Transport runs over the sa_std stateful HTTP
// client (sa_std/http_client.sai, canonical
// sa_std/http/client/http_client.sai, v2 request
// path); URL parsing / quoting is pure byte logic
// written here in full. See README-urllib.md for
// the contract, the base-capability census and
// the registered divergences (including why
// http.client is not written as a second face).
// Panic codes (7718x segment, registered in
// README-urllib.md):
//   77186 URLError: bad or unsupported URL,
//         transport failure inside urlopen
//         (CPython urllib.error.URLError)
//   77187 HTTPError: the server answered with an
//         error status (>= 400), or the redirect
//         limit was exceeded (CPython
//         urllib.error.HTTPError)
//   77188 argument of the wrong type or value, a
//         response used after close, or a surface
//         the base cannot carry (CPython
//         TypeError / ValueError)
//   77189 malformed URL component in
//         urllib.parse accessors (CPython
//         ValueError from SplitResult.port etc.)
//
// Representation rulings (README has the full
// list): byte strings are dyn strs whose byte
// buffer IS the byte string (the base64 / D6
// ruling); a Request is a tag-5 dict record with
// the marker key "psareq"; a response is a tag-5
// dict record with the marker key "psaresp" that
// keeps the base client / request / response
// handles alive until close() because the base
// exposes headers by name only (there is no
// header enumeration in http_client.sai). URL and
// header staging caps: URL 4096 bytes, request
// body 4096 bytes, one header name/value 1024
// bytes -- longer inputs panic instead of
// truncating (registered).

// ---- literal keys ----

fn __psa_urlb_lit_psareq() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 112u8); s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 113u8);
    return s;
}

fn __psa_urlb_lit_url() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 117u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 108u8);
    return s;
}

fn __psa_urlb_lit_data() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 100u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 97u8);
    return s;
}

fn __psa_urlb_lit_headers() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 104u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 100u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 115u8);
    return s;
}

fn __psa_urlb_lit_method() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 109u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 104u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 100u8);
    return s;
}

fn __psa_urlb_lit_psaresp() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 112u8); s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 112u8);
    return s;
}

fn __psa_urlb_lit_status() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 97u8); s = __psa_str_push(s, 116u8); s = __psa_str_push(s, 117u8); s = __psa_str_push(s, 115u8);
    return s;
}

fn __psa_urlb_lit_body() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 98u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 100u8); s = __psa_str_push(s, 121u8);
    return s;
}

fn __psa_urlb_lit_pos() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 112u8); s = __psa_str_push(s, 111u8); s = __psa_str_push(s, 115u8);
    return s;
}

fn __psa_urlb_lit_resp() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 115u8); s = __psa_str_push(s, 112u8);
    return s;
}

fn __psa_urlb_lit_client() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 99u8); s = __psa_str_push(s, 108u8); s = __psa_str_push(s, 105u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 110u8); s = __psa_str_push(s, 116u8);
    return s;
}

fn __psa_urlb_lit_req() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 114u8); s = __psa_str_push(s, 101u8); s = __psa_str_push(s, 113u8);
    return s;
}

// ---- byte helpers ----

fn __psa_urlb_byte(v: PsaVal, i: i64) -> u8 {
    return __psa_bytes_get_h(v.ipay as ptr, i);
}

fn __psa_urlb_len(v: PsaVal) -> i64 {
    return __psa_str_bytes_len(v);
}

// Bytes of s in [start, end) as a new dyn str.
fn __psa_urlb_range(s: PsaVal, start: i64, end: i64) -> PsaVal {
    let out = __psa_str_new();
    let i = start;
    while i < end {
        out = __psa_str_push(out, __psa_urlb_byte(s, i));
        i = i + 1;
    }
    return out;
}

fn __psa_urlb_is_alpha(b: u8) -> bool {
    if b >= 65 {
        if b <= 90 { return true; };
    };
    if b >= 97 {
        if b <= 122 { return true; };
    };
    return false;
}

fn __psa_urlb_is_digit(b: u8) -> bool {
    if b >= 48 {
        if b <= 57 { return true; };
    };
    return false;
}

fn __psa_urlb_is_scheme_char(b: u8) -> bool {
    if __psa_urlb_is_alpha(b) { return true; };
    if __psa_urlb_is_digit(b) { return true; };
    if b == 43 { return true; };
    if b == 45 { return true; };
    if b == 46 { return true; };
    return false;
}

fn __psa_urlb_lower_byte(b: u8) -> u8 {
    if b >= 65 {
        if b <= 90 { return b + 32; };
    };
    return b;
}

fn __psa_urlb_lower(s: PsaVal) -> PsaVal {
    let out = __psa_str_new();
    let n = __psa_urlb_len(s);
    let i: i64 = 0;
    while i < n {
        out = __psa_str_push(out, __psa_urlb_lower_byte(__psa_urlb_byte(s, i)));
        i = i + 1;
    }
    return out;
}

fn __psa_urlb_hex_val(b: u8) -> i64 {
    if __psa_urlb_is_digit(b) { return b as i64 - 48; };
    if b >= 97 {
        if b <= 102 { return b as i64 - 87; };
    };
    if b >= 65 {
        if b <= 70 { return b as i64 - 55; };
    };
    return -1;
}

fn __psa_urlb_hex_upper(v: i64) -> u8 {
    if v < 10 { return 48 + v as u8; };
    return 55 + v as u8;
}

// CPython urlsplit preprocessing: ASCII newline /
// tab / carriage return bytes are removed anywhere
// in the URL, and leading C0 controls and spaces
// are stripped (the 3.6+ safety behaviour).
fn __psa_urlb_clean(url: PsaVal) -> PsaVal {
    let out = __psa_str_new();
    let n = __psa_urlb_len(url);
    let i: i64 = 0;
    let started: bool = false;
    while i < n {
        let b = __psa_urlb_byte(url, i);
        let keep: bool = true;
        if b == 9 { keep = false; };
        if b == 10 { keep = false; };
        if b == 13 { keep = false; };
        if started == false {
            if b <= 32 { keep = false; } else { started = true; };
        };
        if keep { out = __psa_str_push(out, b); };
        i = i + 1;
    }
    return out;
}

// Splits a cleaned URL. Returns a 5-tuple of dyn
// strs (scheme, netloc, path, query, fragment) --
// the exact shape psa_urllib_urlsplit returns.
// Splitting follows RFC 3986 appendix B as CPython
// implements it for the common schemes: fragment
// at the first '#', scheme before the first ':'
// when it precedes any '/', '?' or '#', netloc
// between '//' and the next '/', '?' or end, query
// after '?' up to the fragment.
fn __psa_urlb_split_raw(url: PsaVal) -> PsaVal {
    let s = __psa_urlb_clean(url);
    let n = __psa_urlb_len(s);
    // fragment
    let frag_at: i64 = -1;
    let i: i64 = 0;
    while i < n {
        if __psa_urlb_byte(s, i) == 35 { frag_at = i; i = n; } else { i = i + 1; };
    }
    let main_end = n;
    let fragment = __psa_str_new();
    if frag_at >= 0 {
        fragment = __psa_urlb_range(s, frag_at + 1, n);
        main_end = frag_at;
    };
    // scheme
    let scheme = __psa_str_new();
    let rest_start: i64 = 0;
    let j: i64 = 0;
    let colon: i64 = -1;
    while j < main_end {
        let b = __psa_urlb_byte(s, j);
        if b == 58 { colon = j; j = main_end; } else {
            if b == 47 { j = main_end; } else {
                if b == 63 { j = main_end; } else { j = j + 1; };
            };
        };
    }
    if colon > 0 {
        let ok: bool = __psa_urlb_is_alpha(__psa_urlb_byte(s, 0));
        let k: i64 = 1;
        while k < colon {
            if __psa_urlb_is_scheme_char(__psa_urlb_byte(s, k)) == false { ok = false; };
            k = k + 1;
        }
        if ok {
            scheme = __psa_urlb_lower(__psa_urlb_range(s, 0, colon));
            rest_start = colon + 1;
        };
    };
    // netloc
    let netloc = __psa_str_new();
    let path_start = rest_start;
    if rest_start + 1 < main_end {
        if __psa_urlb_byte(s, rest_start) == 47 {
            if __psa_urlb_byte(s, rest_start + 1) == 47 {
                let e = rest_start + 2;
                let done: bool = false;
                while done == false {
                    if e >= main_end { done = true; } else {
                        let b = __psa_urlb_byte(s, e);
                        if b == 47 { done = true; } else {
                            if b == 63 { done = true; } else { e = e + 1; };
                        };
                    };
                }
                netloc = __psa_urlb_range(s, rest_start + 2, e);
                path_start = e;
            };
        };
    };
    // query
    let q_at: i64 = -1;
    let q = path_start;
    while q < main_end {
        if __psa_urlb_byte(s, q) == 63 { q_at = q; q = main_end; } else { q = q + 1; };
    }
    let path_end = main_end;
    let query = __psa_str_new();
    if q_at >= 0 {
        query = __psa_urlb_range(s, q_at + 1, main_end);
        path_end = q_at;
    };
    let path = __psa_urlb_range(s, path_start, path_end);
    let t = __psa_tuple_new();
    __psa_tuple_push(t, scheme);
    __psa_tuple_push(t, netloc);
    __psa_tuple_push(t, path);
    __psa_tuple_push(t, query);
    __psa_tuple_push(t, fragment);
    return t;
}

fn __psa_urlb_part(parts: PsaVal, i: i64) -> PsaVal {
    return __psa_tuple_get(parts, i);
}

// netloc minus userinfo, minus port: the host
// part, lowercased, brackets stripped for IPv6.
fn __psa_urlb_host_of(netloc: PsaVal) -> PsaVal {
    let n = __psa_urlb_len(netloc);
    // strip userinfo up to the last '@'
    let start: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if __psa_urlb_byte(netloc, i) == 64 { start = i + 1; };
        i = i + 1;
    }
    // bracketed IPv6
    if start < n {
        if __psa_urlb_byte(netloc, start) == 91 {
            let e = start + 1;
            while e < n {
                if __psa_urlb_byte(netloc, e) == 93 {
                    return __psa_urlb_lower(__psa_urlb_range(netloc, start + 1, e));
                };
                e = e + 1;
            }
            return __psa_urlb_lower(__psa_urlb_range(netloc, start + 1, n));
        };
    };
    // host:port -- host ends at the last ':'
    let end = n;
    let k: i64 = start;
    while k < n {
        if __psa_urlb_byte(netloc, k) == 58 { end = k; };
        k = k + 1;
    }
    return __psa_urlb_lower(__psa_urlb_range(netloc, start, end));
}

// The raw port string of a netloc ("" when absent).
fn __psa_urlb_port_str(netloc: PsaVal) -> PsaVal {
    let n = __psa_urlb_len(netloc);
    let start: i64 = 0;
    let i: i64 = 0;
    while i < n {
        if __psa_urlb_byte(netloc, i) == 64 { start = i + 1; };
        i = i + 1;
    }
    if start < n {
        if __psa_urlb_byte(netloc, start) == 91 {
            // IPv6: port follows "]:"
            let e = start + 1;
            while e < n {
                if __psa_urlb_byte(netloc, e) == 93 {
                    if e + 1 < n {
                        if __psa_urlb_byte(netloc, e + 1) == 58 {
                            return __psa_urlb_range(netloc, e + 2, n);
                        };
                    };
                    return __psa_str_new();
                };
                e = e + 1;
            }
            return __psa_str_new();
        };
    };
    let colon: i64 = -1;
    let k: i64 = start;
    while k < n {
        if __psa_urlb_byte(netloc, k) == 58 { colon = k; };
        k = k + 1;
    }
    if colon < 0 { return __psa_str_new(); };
    return __psa_urlb_range(netloc, colon + 1, n);
}

// ---- urllib.parse entry points ----

fn psa_urllib_parse_urlsplit(url: PsaVal) -> PsaVal {
    if url.tag != 6 { panic(77188); };
    return __psa_urlb_split_raw(url);
}

fn psa_urllib_parse_urlunsplit(parts: PsaVal) -> PsaVal {
    if parts.tag != 10 { panic(77188); };
    if __psa_vec_len_h(parts.ipay as ptr) != 5 { panic(77188); };
    let scheme = __psa_urlb_part(parts, 0);
    let netloc = __psa_urlb_part(parts, 1);
    let path = __psa_urlb_part(parts, 2);
    let query = __psa_urlb_part(parts, 3);
    let fragment = __psa_urlb_part(parts, 4);
    let out = __psa_str_new();
    if __psa_urlb_len(scheme) > 0 {
        out = __psa_str_append_str(out, scheme);
        out = __psa_str_push(out, 58u8);
    };
    if __psa_urlb_len(netloc) > 0 {
        out = __psa_str_push(out, 47u8);
        out = __psa_str_push(out, 47u8);
        out = __psa_str_append_str(out, netloc);
        if __psa_urlb_len(path) > 0 {
            if __psa_urlb_byte(path, 0) != 47 {
                out = __psa_str_push(out, 47u8);
            };
        };
    };
    out = __psa_str_append_str(out, path);
    if __psa_urlb_len(query) > 0 {
        out = __psa_str_push(out, 63u8);
        out = __psa_str_append_str(out, query);
    };
    if __psa_urlb_len(fragment) > 0 {
        out = __psa_str_push(out, 35u8);
        out = __psa_str_append_str(out, fragment);
    };
    return out;
}

fn psa_urllib_parse_hostname(parts: PsaVal) -> PsaVal {
    if parts.tag != 10 { panic(77188); };
    let netloc = __psa_urlb_part(parts, 1);
    if __psa_urlb_len(netloc) == 0 { return __psa_m_none(); };
    return __psa_urlb_host_of(netloc);
}

// CPython raises ValueError when .port is read on
// a netloc whose port is not a number in range;
// psa raises it here, at the accessor (77189).
fn psa_urllib_parse_port(parts: PsaVal) -> PsaVal {
    if parts.tag != 10 { panic(77188); };
    let netloc = __psa_urlb_part(parts, 1);
    let ps = __psa_urlb_port_str(netloc);
    if __psa_urlb_len(ps) == 0 { return __psa_m_none(); };
    let n = __psa_urlb_len(ps);
    let v: i64 = 0;
    let i: i64 = 0;
    while i < n {
        let b = __psa_urlb_byte(ps, i);
        if __psa_urlb_is_digit(b) == false { panic(77189); };
        v = v * 10 + (b as i64 - 48);
        if v > 65535 { panic(77189); };
        i = i + 1;
    }
    return __psa_box_int(v);
}

fn __psa_urlb_is_unreserved(b: u8) -> bool {
    if __psa_urlb_is_alpha(b) { return true; };
    if __psa_urlb_is_digit(b) { return true; };
    if b == 95 { return true; };
    if b == 46 { return true; };
    if b == 45 { return true; };
    if b == 126 { return true; };
    return false;
}

fn __psa_urlb_in_str(s: PsaVal, b: u8) -> bool {
    let n = __psa_urlb_len(s);
    let i: i64 = 0;
    while i < n {
        if __psa_urlb_byte(s, i) == b { return true; };
        i = i + 1;
    }
    return false;
}

fn __psa_urlb_quote_impl(s: PsaVal, safe: PsaVal, plus: bool) -> PsaVal {
    let out = __psa_str_new();
    let n = __psa_urlb_len(s);
    let i: i64 = 0;
    while i < n {
        let b = __psa_urlb_byte(s, i);
        let keep: bool = false;
        if __psa_urlb_is_unreserved(b) { keep = true; };
        if __psa_urlb_in_str(safe, b) { keep = true; };
        if keep {
            out = __psa_str_push(out, b);
        } else {
            let encoded: bool = false;
            if plus {
                if b == 32 {
                    out = __psa_str_push(out, 43u8);
                    encoded = true;
                };
            };
            if encoded == false {
                out = __psa_str_push(out, 37u8);
                out = __psa_str_push(out, __psa_urlb_hex_upper(b as i64 >> 4));
                out = __psa_str_push(out, __psa_urlb_hex_upper(b as i64 & 15));
            };
        };
        i = i + 1;
    }
    return out;
}

fn __psa_urlb_lit_slash() -> PsaVal {
    let s = __psa_str_new();
    s = __psa_str_push(s, 47u8);
    return s;
}

fn psa_urllib_parse_quote(s: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    return __psa_urlb_quote_impl(s, __psa_urlb_lit_slash(), false);
}

fn psa_urllib_parse_quote_safe(s: PsaVal, safe: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    if safe.tag != 6 { panic(77188); };
    return __psa_urlb_quote_impl(s, safe, false);
}

fn psa_urllib_parse_quote_plus(s: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    return __psa_urlb_quote_impl(s, __psa_str_new(), true);
}

fn psa_urllib_parse_quote_plus_safe(s: PsaVal, safe: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    if safe.tag != 6 { panic(77188); };
    return __psa_urlb_quote_impl(s, safe, true);
}

fn __psa_urlb_unquote_impl(s: PsaVal, plus: bool) -> PsaVal {
    let out = __psa_str_new();
    let n = __psa_urlb_len(s);
    let i: i64 = 0;
    while i < n {
        let b = __psa_urlb_byte(s, i);
        if b == 37 {
            let done: bool = false;
            if i + 2 < n {
                let h1 = __psa_urlb_hex_val(__psa_urlb_byte(s, i + 1));
                let h2 = __psa_urlb_hex_val(__psa_urlb_byte(s, i + 2));
                if h1 >= 0 {
                    if h2 >= 0 {
                        out = __psa_str_push(out, (h1 * 16 + h2) as u8);
                        i = i + 3;
                        done = true;
                    };
                };
            };
            if done == false {
                out = __psa_str_push(out, b);
                i = i + 1;
            };
        } else {
            if plus {
                if b == 43 {
                    out = __psa_str_push(out, 32u8);
                } else {
                    out = __psa_str_push(out, b);
                };
            } else {
                out = __psa_str_push(out, b);
            };
            i = i + 1;
        };
    }
    return out;
}

fn psa_urllib_parse_unquote(s: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    return __psa_urlb_unquote_impl(s, false);
}

fn psa_urllib_parse_unquote_plus(s: PsaVal) -> PsaVal {
    if s.tag != 6 { panic(77188); };
    return __psa_urlb_unquote_impl(s, true);
}

// ---- query strings ----

// One name=value pair appended to out (with '&'
// separator when out is non-empty).
fn __psa_urlb_encode_pair(out: PsaVal, name: PsaVal, value: PsaVal) -> PsaVal {
    let o = out;
    if __psa_urlb_len(o) > 0 { o = __psa_str_push(o, 38u8); };
    o = __psa_str_append_str(o, __psa_urlb_quote_impl(__psa_str_of(name), __psa_str_new(), true));
    o = __psa_str_push(o, 61u8);
    o = __psa_str_append_str(o, __psa_urlb_quote_impl(__psa_str_of(value), __psa_str_new(), true));
    return o;
