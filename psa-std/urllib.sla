                    if __psa_urlb_byte(scheme, 2) == 116 {
                        if __psa_urlb_byte(scheme, 3) == 112 { scheme_ok = true; };
                    };
                };
            };
        };
        if __psa_urlb_len(scheme) == 5 {
            // "https"
            if __psa_urlb_byte(scheme, 0) == 104 {
                if __psa_urlb_byte(scheme, 1) == 116 {
                    if __psa_urlb_byte(scheme, 2) == 116 {
                        if __psa_urlb_byte(scheme, 3) == 112 {
                            if __psa_urlb_byte(scheme, 4) == 115 { scheme_ok = true; use_tls = 1; };
                        };
                    };
                };
            };
        };
        if scheme_ok == false { panic(77186); };
