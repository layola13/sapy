// info() cannot be carried honestly: the base
// client exposes response headers by name only
// and offers no enumeration, so there is no
// headers mapping to return. Loud refusal
// (77188), registered in README-urllib.md.
fn psa_urllib_info(resp: PsaVal) -> PsaVal {
    panic(77188);
}

fn psa_urllib_close(resp: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    let r = __psa_dict_get(rec, __psa_urlb_lit_resp());
    let c = __psa_dict_get(rec, __psa_urlb_lit_client());
    let q = __psa_dict_get(rec, __psa_urlb_lit_req());
    __psa_urlb_free_handles(c.ipay, q.ipay, r.ipay);
    __psa_dict_set(rec, __psa_urlb_lit_resp(), __psa_box_int(0));
    __psa_dict_set(rec, __psa_urlb_lit_client(), __psa_box_int(0));
    __psa_dict_set(rec, __psa_urlb_lit_req(), __psa_box_int(0));
    __psa_dict_set(rec, __psa_urlb_lit_pos(), __psa_box_int(-1));
    return __psa_m_none();
}
