}

// ---- response surface ----

fn psa_urllib_getcode(resp: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    return __psa_dict_get(rec, __psa_urlb_lit_status());
}

fn psa_urllib_geturl(resp: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    return __psa_dict_get(rec, __psa_urlb_lit_url());
}

fn psa_urllib_read(resp: PsaVal) -> PsaVal {
    return psa_urllib_read_n(resp, __psa_box_int(-1));
}

fn psa_urllib_read_n(resp: PsaVal, n: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    if n.tag != 0 { panic(77188); };
    let pos = __psa_dict_get(rec, __psa_urlb_lit_pos());
    if pos.ipay < 0 { panic(77188); };
    let body = __psa_dict_get(rec, __psa_urlb_lit_body());
    let total = __psa_urlb_len(body);
    let take = total - pos.ipay;
