}

fn psa_urllib_getheader(resp: PsaVal, name: PsaVal) -> PsaVal {
    return psa_urllib_getheader_default(resp, name, __psa_m_none());
}

fn psa_urllib_getheader_default(resp: PsaVal, name: PsaVal, default: PsaVal) -> PsaVal {
    let rec = __psa_urlb_resp_check(resp);
    if name.tag != 6 { panic(77188); };
