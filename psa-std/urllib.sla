        };
        let outresp = [0u64; 1];
        let sts = sa_http_client_req_send_v2(reqh as ptr, &outresp[0]);
        if sts != 0 { __psa_urlb_free_handles(client, reqh, 0); panic(77186); };
        let resp = outresp[0] as i64;
        let code = sa_http_client_resp_status(resp as ptr) as i64;
        // redirect?
        let is_redir: bool = false;
        if code == 301 { is_redir = true; };
        if code == 302 { is_redir = true; };
        if code == 303 { is_redir = true; };
        if code == 307 { is_redir = true; };
        if code == 308 { is_redir = true; };
