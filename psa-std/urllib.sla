            let rec = __psa_dict_new();
            __psa_dict_set(rec, __psa_urlb_lit_psaresp(), __psa_box_int(1));
            __psa_dict_set(rec, __psa_urlb_lit_status(), __psa_box_int(code));
            __psa_dict_set(rec, __psa_urlb_lit_body(), body);
            __psa_dict_set(rec, __psa_urlb_lit_pos(), __psa_box_int(0));
            __psa_dict_set(rec, __psa_urlb_lit_url(), url);
            __psa_dict_set(rec, __psa_urlb_lit_resp(), __psa_box_int(resp));
            __psa_dict_set(rec, __psa_urlb_lit_client(), __psa_box_int(client));
