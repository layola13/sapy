        if timeout.fpay < 0.0 { panic(77188); };
        timeout_ms = (timeout.fpay * 1000.0) as i64;
    };
    if timeout.tag == 0 {
        if timeout.ipay < 0 { panic(77188); };
        timeout_ms = timeout.ipay * 1000;
    };
    if timeout.tag != 3 {
        if timeout.tag != 1 {
            if timeout.tag != 0 { panic(77188); };
        };
    };
    let hops: i64 = 0;
    let finished: bool = false;
