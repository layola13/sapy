fn psa_urllib_urlopen(url: PsaVal) -> PsaVal {
    return psa_urllib_urlopen_full(url, __psa_m_none(), __psa_m_none());
}

fn psa_urllib_urlopen_data(url: PsaVal, data: PsaVal) -> PsaVal {
    return psa_urllib_urlopen_full(url, data, __psa_m_none());
}

fn psa_urllib_urlopen_full(url: PsaVal, data: PsaVal, timeout: PsaVal) -> PsaVal {
    let req = __psa_m_none();
    if url.tag == 6 {
        req = __psa_urlb_req_rec(url, data, __psa_m_none(), __psa_m_none());
    } else {
        if url.tag == 5 {
            req = __psa_urlb_req_check(url);
            if data.tag != 3 {
