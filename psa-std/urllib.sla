                if sth != 0 { __psa_urlb_free_handles(client, reqh, 0); panic(77186); };
            };
            let bbuf = [0u8; 4096];
            let bn = __psa_urlb_len(data);
            if bn > 4096 { __psa_urlb_free_handles(client, reqh, 0); panic(77186); };
            let bi: i64 = 0;
